{
  "name": "gpu-roi",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*", "scripts"],
  "scripts": {
    "test": "npm -w @gpu-roi/engine run test",
    "build": "npm -w @gpu-roi/engine run build && npm -w @gpu-roi/web run build",
    "dev": "npm -w @gpu-roi/web run dev",
    "preview": "npm -w @gpu-roi/web run preview",
    "e2e": "npm -w @gpu-roi/web run e2e",
    "scenario": "npm -w @gpu-roi/scripts run scenario",
    "fetch:openrouter": "npm -w @gpu-roi/scripts run fetch:openrouter",
    "typecheck": "tsc -p packages/engine && tsc -p apps/web --noEmit && tsc -p scripts --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
